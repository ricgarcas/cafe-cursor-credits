# Database — libSQL / SQLite. Two supported forms:
#   • Local file (Railway, Fly, dev):     file:./data/app.db
#   • Turso (Vercel, or anywhere remote): libsql://<name>.turso.io
DATABASE_URL=file:./data/app.db
# Only required when using Turso. Get from: turso db tokens create <name>
# DATABASE_AUTH_TOKEN=

# Session cookie encryption. MUST be 32+ chars.
# Generate with: npm run setup  — or  openssl rand -hex 32
SESSION_PASSWORD=change_me_to_a_long_random_secret_at_least_32_chars_long

# Required to create the first admin at /admin-register. Generate any secret
# string. Without it, whoever opens a fresh deployment first becomes admin.
ADMIN_SETUP_PHRASE=

# App URL (used for absolute links in emails).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public origin of this deployment, used to mint and validate MCP OAuth tokens.
# Normally detected from X-Forwarded-Host/Proto, so leave it unset. Set it only
# if your proxy strips those headers — otherwise the app mints tokens for its
# internal hostname and then rejects them.
# PUBLIC_URL=https://cafecursor.yourcity.dev

# ============================================
# Configured in the admin Settings page, not env:
# - City name, country, timezone, language
# - Resend API key (for sending coupon emails)
# - Luma API key + optional Calendar ID (for Luma event sync)
# ============================================
